{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/",
      "destination": "/es/",
      "permanent": false
    }
  ],

  "rewrites": [
    {
      "source": "/es/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/index.html"
    },

    {
      "source": "/persona/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/dinastia/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/territorio/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/historia/:slug",
      "destination": "/index.html"
    }
  ]
}
