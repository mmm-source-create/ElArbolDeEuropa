# Variables públicas de Vite. Configúralas en Vercel cuando el dominio/correo existan.
# No pongas secretos aquí: VITE_* se incorpora al código cliente.
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
# Normalmente se deja vacío para Vercel. build:cloudflare fija cloudflare automáticamente.
VITE_HOSTING_PROVIDER=
