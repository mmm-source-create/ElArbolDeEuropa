{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eade-cloudflare-preview",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/", "/index.html", "/404.html",
      "/es", "/es/*", "/en", "/en/*", "/embed/*",
      "/persona/*", "/dinastia/*", "/territorio/*", "/historia/*",
      "/api", "/api/*"
    ]
  },
  "vars": {
    "DEPLOYMENT_ENV": "preview"
  },
  "observability": {
    "enabled": true
  }
}
